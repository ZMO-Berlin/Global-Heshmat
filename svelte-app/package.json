{
	"name": "global-heshmat",
	"private": true,
	"version": "0.0.1",
	"description": "Interactive map tracing the public artworks of Egyptian sculptor Hassan Heshmat (1920–2006) across Egypt, Europe, and beyond. A project by ZMO Berlin.",
	"homepage": "https://heshmat.zmo.de/",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ZMO-Berlin/Global-Heshmat.git",
		"directory": "svelte-app"
	},
	"bugs": {
		"url": "https://github.com/ZMO-Berlin/Global-Heshmat/issues"
	},
	"author": "Leibniz-Zentrum Moderner Orient (ZMO), Berlin (https://www.zmo.de)",
	"license": "MIT",
	"keywords": [
		"sveltekit",
		"maplibre-gl",
		"digital-humanities",
		"interactive-map",
		"art-history"
	],
	"type": "module",
	"engines": {
		"node": "^22.13.0 || ^24.0.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"images": "node scripts/generate_image_derivatives.mjs",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"test:lighthouse": "node scripts/lighthouse-budget.mjs",
		"audit:prod": "npm audit --omit=dev --audit-level=high",
		"verify:build": "node scripts/verify-build.mjs",
		"validate": "npm run lint && npm run check && npm run test && npm run build && npm run verify:build && npm run test:e2e && npm run test:lighthouse"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/node": "^26.4.0",
		"@vite-pwa/sveltekit": "^1.1.0",
		"@vitest/ui": "^4.1.11",
		"eslint": "^10.9.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.11.0",
		"chrome-launcher": "^1.2.1",
		"lighthouse": "^13.4.1",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"sharp": "^0.35.4",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.68.0",
		"vite": "^8.2.2",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@fontsource-variable/cormorant-garamond": "^5.3.0",
		"@fontsource-variable/outfit": "^5.3.0",
		"@lucide/svelte": "^1.35.0",
		"@mapbox/mapbox-gl-rtl-text": "^0.4.0",
		"maplibre-gl": "^6.6.0"
	},
	"overrides": {
		"brace-expansion": "^5.0.9",
		"cookie": "^0.7.0",
		"fast-uri": "^4.1.2"
	}
}
